# Purple Ops theme for cmus
# Matches the Kitty / Orchis-Purple cyber-aesthetic
set color_cmdline_bg=default
set color_cmdline_fg=13
set color_error=1
set color_info=6
set color_separator=8
set color_statusline_bg=0
set color_statusline_fg=13
set color_titleline_bg=5
set color_titleline_fg=0
set color_win_bg=default
set color_win_cur=13
set color_win_cur_sel_bg=5
set color_win_cur_sel_fg=0
set color_win_dir=14
set color_win_fg=default
set color_win_inactive_cur_sel_bg=0
set color_win_inactive_cur_sel_fg=13
set color_win_inactive_sel_bg=0
set color_win_inactive_sel_fg=7
set color_win_sel_bg=5
set color_win_sel_fg=0
set color_win_title_bg=0
set color_win_title_fg=13
